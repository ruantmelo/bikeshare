# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://bikeshare:bikeshare123@localhost:5433/bikeshare"

# Secret used to sign/verify JWT tokens
JWT_SECRET="change_me"

# MQTT broker URL the telemetry subscriber connects to.
# Local dev: mqtt://localhost:1884
# HiveMQ Cloud: mqtts://<cluster-host>:8883
MQTT_BROKER="mqtt://localhost:1884"

# Optional MQTT authentication/TLS options. HiveMQ Cloud requires username and password.
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_CLIENT_ID="bikeshare-backend-dev"
MQTT_REJECT_UNAUTHORIZED=true
MQTT_CONNECT_TIMEOUT_MS=30000
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_KEEPALIVE_SECONDS=60
MQTT_CLEAN=true

# HTTP port the API listens on
PORT=3000
